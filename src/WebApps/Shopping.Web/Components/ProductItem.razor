
<div class="card">
    <a asp-page="ProductDetail" asp-route-productId="@Product.Id"><img asp-append-version="true" class="card-img-top" src="/images/product/@Product.ImageFile" alt=""></a>
    <div class="card-body">
        <h4 class="card-title"><a asp-page="ProductDetail" asp-route-productId="@Product.Id" class="color-main">@Product.Name</a></h4>
        <p class="card-text">@Product.Description</p>
        <div class="row">
            <div class="col">
                <p class="btn btn-danger btn-block">@Product.Price $</p>
            </div>
            <div class="col">

                @*<a asp-page="Cart" asp-route-productId="@Model.Id" class="btn btn-success btn-block">Add to Cart</a>*@
@* 
                <form asp-page-handler="AddToCart" method="post" name="addToCartForm" id="add_cart_form">
                    <a href="javascript:;" onclick="parentNode.submit();" class="btn btn-success btn-block">Add to Cart</a>
                    <input type="hidden" asp-for=" " name="productId" />
                </form> *@

                <button class="btn btn-info" @onclick="@OnAddToBasket" value="Ajouter au panier"></button>

            </div>
        </div>
    </div>
</div>

@code {


    [Parameter]
    public ProductModel Product { get; set; } = new();

    [Parameter]
    protected EventCallback<string> OnAddToBasketCallback { get; set; }


